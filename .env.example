# Copy to .env.local for development. Never commit real values.

# production = indexable. preview / development = noindex (Vercel sets VERCEL_ENV automatically).
NEXT_PUBLIC_SITE_ENV=development

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend). FROM_EMAIL must be on a domain verified in Resend (SPF, DKIM, DMARC).
# EMAIL_TRANSPORT=console prints emails to the server log instead of sending (local testing only).
# In development without RESEND_API_KEY the console mailer is used automatically; in production a
# missing key makes the form show the WhatsApp/phone fallback instead of pretending to send.
EMAIL_TRANSPORT=
RESEND_API_KEY=
SALES_EMAIL=sales@ultimatepos.co.ke
FROM_EMAIL=no-reply@ultimatepos.co.ke

# Rate limiting (Upstash Redis). Without these, an in-memory limiter is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: also POST every lead to a CRM / Google Sheets webhook
LEAD_WEBHOOK_URL=

# Error monitoring
SENTRY_DSN=

# Search engine / Meta verification codes (only the code, not the whole <meta> tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=
FACEBOOK_APP_ID=
