# Copy to .env.local for development. Never commit real values.
# Production: copy to website.env next to the POS .env (chmod 600), with NEXT_PUBLIC_SITE_ENV=production.
# NEXT_PUBLIC_* and the verification codes at the bottom are fixed into the build: in production they
# go in the POS .env as build args (see the backend repo's deploy/.env.example), then `./pos.sh build site`.

# production = indexable. preview / development = noindex.
NEXT_PUBLIC_SITE_ENV=development

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend). FROM_EMAIL must be on a domain verified in Resend (SPF, DKIM, DMARC).
# EMAIL_TRANSPORT=console prints emails to the server log instead of sending (local testing only;
# production builds ignore it unless the end-to-end tests also set ALLOW_CONSOLE_EMAIL=true).
# In development without RESEND_API_KEY the console mailer is used automatically; in production a
# missing key makes the form show the WhatsApp/phone fallback instead of pretending to send.
EMAIL_TRANSPORT=
RESEND_API_KEY=
SALES_EMAIL=sales@ultimatepos.co.ke
FROM_EMAIL=no-reply@ultimatepos.co.ke

# Rate limiting (Upstash Redis). Without these, an in-memory limiter is used: it works with one
# container but resets whenever the site restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: also POST every lead to a CRM / Google Sheets webhook
LEAD_WEBHOOK_URL=

# Error monitoring
SENTRY_DSN=

# Search engine / Meta verification codes (only the code, not the whole <meta> tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=
FACEBOOK_APP_ID=
